# Copy this file to `conf.env` and fill in your values.

# --- Which chat app to use: telegram (default) or discord ---
# Leave it out and the bot picks whichever token you filled in below.
# CHAT_PLATFORM=telegram

# --- Required for Telegram: bot token (from @BotFather) ---
# Uncomment and fill in. (Left commented, so a Discord-only setup doesn't
# start on Telegram with this placeholder.)
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# --- Optional: notify chat ---
# Where new-video messages are sent. Leave it unset and the bot learns your
# chat from the first /start you send it (later /starts from other chats are
# refused, so nobody else can redirect your notifications).
# TELEGRAM_CHAT_ID=123456789

# --- Required for Discord instead: bot token ---
# From https://discord.com/developers/applications (Bot -> Reset Token). Invite
# the bot with the `bot` + `applications.commands` scopes and the Send Messages
# and Embed Links permissions, then run /start in a channel.
# DISCORD_BOT_TOKEN=your-discord-bot-token
# Pin the channel instead of learning it from /start:
# DISCORD_CHANNEL_ID=123456789012345678
# Your server id — slash commands appear there instantly instead of taking up
# to an hour to register globally.
# DISCORD_GUILD_ID=123456789012345678

# --- Optional: how often to check channels (minutes, default 30, minimum 1) ---
# CHECK_INTERVAL_MINUTES=30

# --- Optional: retry transient feed-fetch failures ---
# YouTube briefly throttles bursts of RSS requests with 5xx/404 errors. Retry
# each feed this many times with exponential backoff (base seconds) before
# giving up. Set FEED_FETCH_RETRIES=0 to disable. Defaults: 3 retries, 1s base.
# FEED_FETCH_RETRIES=3
# FEED_FETCH_BACKOFF=1

# --- Optional: pace feed fetches to avoid tripping the throttle ---
# Pause this many seconds between channel feeds during a check. Spacing the
# requests keeps the pass under YouTube's burst throttle, so the 404/5xx errors
# above rarely fire at all. Set to 0 to fetch as fast as possible. Default: 0.5s.
# FEED_FETCH_PACING_SECONDS=0.5

# --- Optional: skip resurfaced old videos ---
# YouTube sometimes puts an old video back in a channel's feed (e.g. an unlisted
# video made public keeps its original upload date). Skip (but still record)
# videos released more than this many days ago. Set to 0 to disable. Default: 14.
# MAX_VIDEO_AGE_DAYS=14

# --- Optional: YouTube playlist the 💾 Save button fills ---
# Auto-created in your account the first time. Requires the one-time
# `python manual-setup/authorize_youtube.py` step (see the README).
# YOUTUBE_PLAYLIST_NAME=Telegram Watchlist

# --- Optional: YouTube Data API key ---
# A separate read-only key that improves video/livestream detection and adds
# scheduled start times. Leave blank to use the no-key scraping fallback.
YOUTUBE_API_KEY=

# --- Optional: file paths (defaults shown, all next to the code) ---
# A relative path here is resolved against the folder the code lives in, not
# the directory the bot happens to be started from.
# Your watchlist is your YouTube account's subscriptions (read via OAuth).
# EXCEPTIONS_FILE lets you opt out of some of them — see exceptions.txt.
# EXCEPTIONS_FILE=exceptions.txt
# ARCHIVE_FILE=archive.json
# Folder for the daily .log run logs (one file per day). Default: logs/
# LOG_DIR=logs
# YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
# YOUTUBE_TOKEN_FILE=youtube_token.json
# Cached id of your saved-videos playlist.
# YOUTUBE_PLAYLIST_STATE_FILE=youtube_state.json
# Separate "TVs and Limited Input devices" OAuth client for the device flow
# (`authorize_youtube.py --device`, /authorize). Default: YOUTUBE_CLIENT_SECRET_FILE.
# YOUTUBE_DEVICE_CLIENT_SECRET_FILE=client_secret_device.json
