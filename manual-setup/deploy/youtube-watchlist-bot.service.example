# Template — do NOT edit this file in place. Copy it, then edit the copy:
#   cp youtube-watchlist-bot.service.example youtube-watchlist-bot.service
# Your copy (manual-setup/deploy/youtube-watchlist-bot.service) is gitignored, so your
# edits stay local and never block a `git switch`/`pull` or get pushed.

[Unit]
# The whole bot in one always-on process: periodic channel checks + the
# 💾 Save / 🗑 Delete buttons and chat commands.
Description=YtWatchlistBot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --- Edit these three to match your setup ---
User=youruser
WorkingDirectory=/home/youruser/server_YtWatchlistBot
ExecStart=/usr/bin/python3 ytwatchlistbot.py
# ------------------------------------------
# config.py also loads a local conf.env, so this line is optional if you keep a
# conf.env in WorkingDirectory.
EnvironmentFile=-/home/youruser/server_YtWatchlistBot/conf.env
Restart=always
RestartSec=5
# Tag journal lines so `journalctl -t youtube-watchlist-bot` filters cleanly.
SyslogIdentifier=youtube-watchlist-bot

[Install]
WantedBy=multi-user.target
